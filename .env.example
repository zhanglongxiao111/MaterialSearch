# MaterialSearch 环境变量配置模板
# 复制此文件为 .env 并修改配置

# ===========================================
# 基础配置
# ===========================================
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# ===========================================
# 素材路径配置
# ===========================================
# 多个路径用逗号分隔
ASSETS_PATH=C:/Users/Administrator/Pictures,C:/Users/Administrator/Videos
# 跳过的路径
SKIP_PATH=C:/Users/Administrator/AppData

# ===========================================
# 数据库配置
# ===========================================
# 是否使用 Supabase（false 时使用本地 SQLite）
USE_SUPABASE=false

# Supabase 配置（USE_SUPABASE=true 时必填）
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# SQLite 数据库路径（USE_SUPABASE=false 时使用）
SQLITE_DATABASE_PATH=./instance/permanent.db

# ===========================================
# 认证配置
# ===========================================
# 是否启用登录（兼容旧版单用户模式）
ENABLE_LOGIN=false
# 旧版单用户模式配置（ENABLE_LOGIN=true 且 USE_SUPABASE=false 时使用）
USERNAME=admin
PASSWORD=admin

# JWT 配置（USE_SUPABASE=true 时使用 Supabase 内置 JWT）
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION_HOURS=24

# ===========================================
# AI 模型配置
# ===========================================
# CLIP 模型名称
MODEL_NAME=OFA-Sys/chinese-clip-vit-base-patch16
# 是否使用 GPU
USE_GPU=true
# 批处理大小（根据显存调整，4GB 显存建议 6，8GB 建议 12）
SCAN_PROCESS_BATCH_SIZE=6

# ===========================================
# 搜索配置
# ===========================================
# 正向阈值（越高越严格）
POSITIVE_THRESHOLD=0.27
# 反向阈值
NEGATIVE_THRESHOLD=0.27
# 图片相似度阈值
IMAGE_THRESHOLD=0.9

# ===========================================
# 性能配置
# ===========================================
# 是否自动扫描
AUTO_SCAN=true
# 扫描间隔（秒）
SCAN_INTERVAL=3600
# 缓存大小
CACHE_SIZE=1000

# ===========================================
# 代理配置（可选，用于模型下载）
# ===========================================
# http_proxy=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890
